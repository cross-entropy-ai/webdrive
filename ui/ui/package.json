{
	"name": "ui",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun --hot src/index.ts",
		"build": "bun build ./src/index.html --outdir=dist --target=browser --minify --define:process.env.NODE_ENV='\"production\"'",
		"start": "NODE_ENV=production bun src/index.ts",
		"fmt": "biome format --write ."
	},
	"dependencies": {
		"@iconify/react": "^6.0.2",
		"@tailwindcss/vite": "^4.2.4",
		"framer-motion": "^12.38.0",
		"geist": "^1.7.0",
		"next-themes": "^0.4.6",
		"react": "^19",
		"react-dom": "^19",
		"tailwindcss": "^4"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.13",
		"@types/bun": "latest",
		"@types/react": "^19",
		"@types/react-dom": "^19"
	}
}
